diff --git a/dist/index.cjs b/dist/index.cjs
index 9b1289e66449ca7252cc4bd86922f8f400759460..8e81545a5d85bbc16ef6f36a870d90757b5e038a 100644
--- a/dist/index.cjs
+++ b/dist/index.cjs
@@ -762,14 +762,17 @@ function scrollIntoViewport(targetElement, opts) {
         targetElement.scrollIntoView?.({ block: "nearest" });
       }
     } else {
-      let scrollParent = getScrollParent(targetElement);
+      let scrollParent = targetElement.parentElement ? getScrollParent(targetElement.parentElement) : null;
       while (targetElement && scrollParent && targetElement !== root && scrollParent !== root) {
         scrollIntoView(
           scrollParent,
           targetElement
         );
         targetElement = scrollParent;
-        scrollParent = getScrollParent(targetElement);
+        // zen-ui patch: targetElement is now a scroll parent, and getScrollParent(x)
+        // returns x itself when x scrolls, so this looped forever (a keyboard-opened
+        // menu froze the page). Start from its parent instead.
+        scrollParent = targetElement.parentElement ? getScrollParent(targetElement.parentElement) : null;
       }
     }
   }
